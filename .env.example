# MongoDB Atlas Connection String
# Get this from MongoDB Atlas Dashboard -> Connect -> Drivers
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/bitlinks?retryWrites=true&w=majority"

# JWT Secret Key for Session Encryption
# Use a strong random string (e.g. generated via `openssl rand -hex 32`)
JWT_SECRET="your-super-secret-jwt-key-here"

# Application Base URL (Used for generating absolute short URLs)
# In production on Vercel, set this to your custom domain or Vercel URL
# e.g., https://bitlinks.vercel.app
APP_URL="https://your-app-name.vercel.app"

# API URL matching APP_URL for frontend compatibility
VITE_API_URL="https://your-app-name.vercel.app"

# Server Port (Optional for local development, defaults to 3000)
PORT="3000"
